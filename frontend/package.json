{
  "name": "cmpg-521-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "sync:contract": "node tools/sync-contract.js",
    "prestart": "npm run sync:contract",
    "start": "ng serve --open",
    "prebuild": "npm run sync:contract",
    "build": "ng build",
    "build:archive": "ch5-cli archive -c src/config/AppContract.cse2j -p cmpg-521-ui -d dist/cmpg-521-ui/ -o archive",
    "cresprep": "replace-in-files --string='type=\\\"module\\\"' --replacement='defer' dist/cmpg-521-ui/index.html",
    "compile": "npm run build && npm run build:archive",
    "deployt": "ch5-cli deploy -H 192.168.2.31 -t touchscreen -p archive/cmpg-521-ui.ch5z",
    "deployp": "ch5-cli deploy -H 192.168.2.95 -t controlsystem -p archive/cmpg-521-ui.ch5z",
    "prewatch": "npm run sync:contract",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.10",
    "@angular/common": "^18.2.10",
    "@angular/compiler": "^18.2.10",
    "@angular/core": "^18.2.10",
    "@angular/forms": "^18.2.10",
    "@angular/platform-browser": "^18.2.10",
    "@angular/platform-browser-dynamic": "^18.2.10",
    "@angular/router": "^18.2.10",
    "@crestron/ch5-crcomlib": "^2.11.2",
    "@crestron/ch5-shell-utilities-cli": "^2.11.2",
    "@crestron/ch5-theme": "^2.11.2",
    "@crestron/ch5-utilities-cli": "^2.0.0",
    "@crestron/ch5-webxpanel": "^2.8.0",
    "@ng-bootstrap/ng-bootstrap": "^17.0.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "g": "^2.0.1",
    "ng-toggle-button": "^1.5.3",
    "remixicon": "^4.4.0",
    "replace-in-files-cli": "^3.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.2",
    "zone.js": "^0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.11",
    "@angular/cli": "^18.2.11",
    "@angular/compiler-cli": "^18.2.10",
    "@angular/localize": "^18.2.10",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.4"
  }
}
