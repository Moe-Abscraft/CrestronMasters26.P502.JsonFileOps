Thumbs.db

# Generated by tools/sync-contract.js from the authored *.cse2j in src/config.
# WebXPanel fetches config/contract.cse2j by a hard-coded path; the authored
# file (e.g. AppContract.cse2j) is the one under version control.
/src/config/contract.cse2j
