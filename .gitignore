# ------------------------------------------------------------------
# CrestronMasters26.P502.JsonFileOps
# backend/  = SIMPL# Pro (.NET 8) program      frontend/ = Angular CH5 UI
# ------------------------------------------------------------------

# ---------- .NET / Visual Studio (backend) ----------
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo
*.userprefs
*.swp
*.DotSettings.user
launchSettings.json
TestResults/
*.log

# Crestron build outputs (regenerated by the SDK post-build step)
*.cpz
*.clz
*.cplz
ProgramInfo.config

# ---------- Node / Angular (frontend) ----------
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/archive/
frontend/*.ch5z
npm-debug.log*
yarn-error.log*
.eslintcache

# Generated by frontend/tools/sync-contract.js on every start/build.
# The authored contract stays in frontend/src/config/AppContract.cse2j
# and contract/AppContract.cce.
frontend/src/config/contract.cse2j

# ---------- Editors / OS ----------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# ---------- Local-only ----------
# Per-processor XPanel tokens, IPs, passwords — never commit these.
*.local.*
.env
.env.*
